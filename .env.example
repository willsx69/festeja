# URL pública usada em links de confirmação e recuperação de senha.
APP_URL=http://localhost:3000

# true exige confirmação antes de liberar a conta; false permite uso imediato.
REQUIRE_EMAIL_VERIFICATION=false

# PostgreSQL obrigatório na Vercel. Prefira uma URL com pool para serverless.
DATABASE_URL=

# PGlite local. Não configure este caminho na Vercel.
FESTEJA_DB_PATH=./data/festeja.db

# 1/true popula os dados de demonstração; 0/false deixa o banco vazio.
# Em produção o seed é desativado por padrão.
FESTEJA_SEED=0

# Diretório de imagens usado apenas no desenvolvimento local.
FESTEJA_UPLOADS_DIR=./public/uploads

# Criado automaticamente ao conectar um Vercel Blob ao projeto.
BLOB_STORE_ID=
# Alternativa para operações locais sem OIDC.
BLOB_READ_WRITE_TOKEN=

# Envio de e-mail transacional (confirmação de conta e recuperação de senha).
# Sem essas variáveis, os fluxos continuam seguros, mas nenhum e-mail é enviado.
RESEND_API_KEY=
EMAIL_FROM=Festeja <no-reply@festeja.com.br>
